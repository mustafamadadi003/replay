# ─── Railway: set these on BOTH services (web + worker) ───────────────────────
# Reference Railway plugins with ${{Postgres.DATABASE_URL}} / ${{Redis.REDIS_URL}}.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# web: SERVICE_ROLE=web (default)   worker: SERVICE_ROLE=worker
SERVICE_ROLE=web

# Public https URL of the web service, e.g. https://rahbin-reply.up.railway.app
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
# Must stay identical to the value used when tokens were saved, or stored
# Page/IG tokens cannot be decrypted.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Login page (single shared office password)
OFFICE_ACCESS_CODE=change-me
# OFFICE_LOGIN_EMAIL=admin@rahbin.local

# Meta
META_GRAPH_API_VERSION=v25.0
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token
META_SYSTEM_USER_TOKEN=

# worker only: run /api/cron jobs from the worker container
# CRON_BASE_URL=https://rahbin-reply.up.railway.app

# Unused when only office login is enabled
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>
